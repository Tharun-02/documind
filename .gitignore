# DocuMind - .gitignore

# !! CRITICAL !! — API keys and secrets
.env
*.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Uploads (user files — not committed)
uploads/
resume/

# DB (local only)
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test coverage
.coverage
htmlcov/

# Local logs
*.log
server_output.txt

# Local test files
file1.pdf
file2.pdf

# Graphify (regenerated)
graphify-out/

# Plans (local-only working docs — never committed)
docs/
docs/plans/
docs/concepts/
docs/LEARNINGS.md