# ── Environment Variables for DocuMind ─────────────────────
# Copy this file to .env and fill in the values

# ── Database ────────────────────────
# For local development: sqlite:///./documind.db
# For production (PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./documind.db

# ── Redis ───────────────────────────
# For local development: redis://localhost:6379/0
# For production: redis://:password@host:port/0
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Embeddings Configuration ────────
EMBEDDING_PROVIDER=huggingface  # or cohere, google
HUGGINGFACE_API_KEY=your-huggingface-api-key
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=mixtral-8x7b-32768

# ── OpenAI (Optional) ───────────────
# OPENAI_API_KEY=your-openai-api-key

# ── Pinecone (Vector DB) ────────────
# Get from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=documind
PINECONE_ENVIRONMENT=us-east-1-aws

# ── LangSmith (Tracing & Observability) ──────
# Get from: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=documind

# ── File Storage ────────────────────────
UPLOAD_DIR=./uploads

# ── App Settings ───────────────────────
APP_NAME=DocuMind
DEBUG=false

# ── CORS Configuration ────────────────
# Set comma-separated list of allowed origins for production
# Example: CORS_ORIGINS=https://your-app.netlify.app,https://www.your-domain.com
CORS_ORIGINS=*

# ── Other API Keys ────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
NVIDIA_API_KEY=your-nvidia-api-key